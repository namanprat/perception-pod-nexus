---
const slides = [
  {
    header: "A Brand is a Living Mosaic",
    body: "Brands aren't static pages in a deck. They're living mosaics of contradictions, emotions, and human stories. We nurture the ones that refuse to sit still in perfect little boxes, the ones that listen to the chaos and evolve with the weather.",
  },
  {
    header: "Wild Things Grow Best",
    body: "Forget the rulebook. Authentic brands don't bloom from templates, they erupt from soil-deep understanding and wild intention. We dig into the messy dirt of human truth, because real growth doesn't follow instructions. It follows instinct.",
  },
  {
    header: "Every Element Serves a Purpose",
    body: "In our garden, nothing exists just to look pretty. Every petal attracts, every stem supports, every root feeds the whole. Your brand isn't decoration, it's a living organism where design meets data and strategy blooms into stories that matter.",
  },
];

const first = slides[0];
---

<section class="scrub_text_wrap" data-scrub-text>
  <script type="application/json" data-scrub-slides set:html={JSON.stringify(slides)} />

  <div class="scrub_text_sticky">
    <div
      class="scrub_contain"
      id="pp-scrub"
      data-asset-base-url="/frames"
      data-asset-extension="webp"
      data-first-frame="0"
      data-frame-count="201"
      data-eager-count="25"
      aria-hidden="true"
    ></div>

    <div class="scrub_text_dock u-container">
      <div class="scrub_text_grid u-grid-main">
      <div class="scrub_text_main u-column-span-4">
          <div class="scrub_text_header_wrap">
            <h1 class="scrub_text_header u-text-style-h1">{first.header}</h1>
          </div>
          <p class="scrub_text_body u-text-style-large">{first.body}</p>
        </div>
      </div>
    </div>
  </div>
</section>
