---
---

<section class="hero_wrap">
  <div class="hero_contain u-container">
    <div class="hero_top">
      <img
        src="/assets/logo.svg"
        alt="Perception Pod"
        class="hero_wordmark"
      />
    </div>
    <div class="hero_bottom">
      <div class="hero_bottom_wrap">
        <ul class="hero_links u-text-style-h6" role="list">
          <li class="hero_nav_item">
            <span class="hero_link" data-clock>00:00:00 IST</span>
          </li>
          <li class="hero_nav_item">
            <span class="hero_link">Delhi, India</span>
          </li>
        </ul>

        <div class="hero_center">
          <h3 id="header-split" class="hero_title u-text-style-h3">
            Garden of Growth,<br />A Creative Intelligence Studio
          </h3>
          <div class="hero_actions u-button-wrapper">
            <button
              type="button"
              class="btn_wrap"
              data-contact-open
              data-trigger="hover focus"
            >
              <span class="btn_text">Contact</span>
            </button>
          </div>
        </div>

        <ul class="hero_links u-text-style-h6" role="list">
          <li class="hero_nav_item">
            <a class="hero_link" href="#services">Services</a>
          </li>
          <li class="hero_nav_item">
            <a class="hero_link" href="#about">About</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
