---
---

<footer class="footer_wrap" id="contact">
  <div class="footer_media">
    <img class="footer_media_img" src="/assets/footer-bloom.png" alt="" />
  </div>
  <div class="footer_contain u-container">
    <div class="footer_top">
      <h2 class="u-text-style-h1">Got a project? Let's talk</h2>
      <div class="footer_actions u-button-wrapper">
        <button
          type="button"
          class="btn_wrap"
          data-contact-open
          data-trigger="hover focus"
        >
          <span class="btn_text">Get in touch</span>
        </button>
      </div>
    </div>

    <div class="footer_links">
      <a class="footer_link u-text-style-h6" href="#" data-trigger="hover focus"
        >LinkedIn</a
      >
      <a class="footer_link u-text-style-h6" href="#" data-trigger="hover focus"
        >Instagram</a
      >
      <a
        class="footer_link u-text-style-h6"
        href="mailto:hello@perceptionpod.com"
        data-trigger="hover focus">Email</a
      >
    </div>
  </div>

  <img
    src="/assets/logo.svg"
    alt="Perception Pod"
    class="footer_wordmark"
  />
</footer>
