</BaseLayout>
<script>
  /* Resolved-value readout. getComputedStyle().getPropertyValue() on a custom
     property returns the *specified* value — the literal "clamp(...)" string —
     so every number here comes from measuring a probe element instead. */
  import { readCssLengthPx } from "../../lib/css-length";
  import {
    applyContainerLockSettings,
    clearContainerLockOverride,
    clearContainerLockStorage,
    DEFAULT_CONTAINER_WIDTH_REM,
    readContainerLockSettings,
    writeContainerLockSettings,
  } from "../../lib/container-lock";
  import {
    addSwatch,
    applyExtraSwatches,
    applySwatchSettings,
    clearExtraSwatchStorage,
    clearSwatchOverride,
    clearSwatchStorage,
    DEFAULT_SWATCHES,
    listExtraSwatches,
    normalizeHex,
    readExtraSwatches,
    readSwatchSettings,
    removeSwatch,
    SWATCH_KEYS,
    type SwatchKey,
    writeExtraSwatches,
    writeSwatchSettings,
  } from "../../lib/swatch-colours";
  import {
    applyFontFamilySettings,
    applyTextStyleFontSettings,
    clearFontFamilyOverride,
    clearFontFamilyStorage,
    clearTextStyleFontOverride,
    clearTextStyleFontStorage,
    DEFAULT_FONT_FAMILIES,
    DEFAULT_TEXT_STYLE_FONTS,
    FONT_ROLES,
    type FontRole,
    isFontRole,
    readFontFamilySettings,
    readTextStyleFontSettings,
    TEXT_STYLE_KEYS,
    type TextStyleKey,
    writeFontFamilySettings,
    writeTextStyleFontSettings,
  } from "../../lib/text-style-fonts";
  import {
    applyTypeStylesEnabled,
    clearTypeStylesEnabledStorage,
    readTypeStylesEnabled,
    writeTypeStylesEnabled,
  } from "../../lib/type-styles-enabled";
  import {
    clearFontCatalogStorage,
    clearTypekitKitId,
    DEFAULT_FONT_CATALOG,
    ensureTypekitLink,
    fetchTypekitFamilies,
    mergeFontCatalog,
    NEXUS_FONT_STACK,
    readFontCatalog,
    readTypekitKitId,
    type FontCatalogEntry,
    writeFontCatalog,
    writeTypekitKitId,
  } from "../../lib/typekit";
  import {
    applyTextStyleOptionSettings,
    clearTextStyleOptionOverride,
    clearTextStyleOptionStorage,
    DEFAULT_TEXT_STYLE_OPTIONS,
    isTextAlign,
    isTextTransform,
    isTextWeight,
    isTextWrap,
    readTextStyleOptionSettings,
    writeTextStyleOptionSettings,
    type TextStyleOptions,
  } from "../../lib/text-style-options";
  import {
    applyButtonStyleSettings,
    BUTTON_STYLE_KEYS,
    type ButtonStyleKey,
    clearButtonStyleOverride,
    clearButtonStyleStorage,
    DEFAULT_BUTTON_STYLES,
    isPillRadius,
    radiusToRem,
    remToRadius,
    readButtonStyleSettings,
    writeButtonStyleSettings,
  } from "../../lib/button-styles";
  import {
    applySpacingRungSettings,
    clearSpacingRungStorage,
    DEFAULT_SPACING_RUNGS,
    readSpacingRungSettings,
    writeSpacingRungSettings,
  } from "../../lib/spacing-rungs";
  import { saveTokensToCss } from "../../lib/save-tokens";
  import { FEATURE_KEYS, FEATURE_META } from "../../lib/features";

  document.addEventListener("DOMContentLoaded", function () {
    let paintMetrics: (() => void) | null = null;
    const statusEl = document.querySelector<HTMLElement>("[data-save-status]");

    const setSaveStatus = (message: string) => {
      if (statusEl) statusEl.textContent = message;
    };

    const persist = async (
      payload: Parameters<typeof saveTokensToCss>[0],
      onFallback: () => void,
      onSaved?: () => void,
    ) => {
      const saved = await saveTokensToCss(payload);
      if (saved) {
        onSaved?.();
        setSaveStatus("Saved to src/styles/nexus/variables.css");
        paintMetrics?.();
        return;
      }
      onFallback();
      setSaveStatus("Dev server unavailable — kept as a session override only");
      paintMetrics?.();
    };

    document.querySelectorAll<HTMLElement>(".type_specimen_wrap").forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = "true";

      const paint = () => {
        const rootPx =
          parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

        for (const el of document.querySelectorAll<HTMLElement>("[data-computed]")) {
          const px = readCssLengthPx(el.dataset.computed!);
          el.textContent = px ? `${px.toFixed(1)}px · ${(px / rootPx).toFixed(3)}rem` : "—";
        }

        for (const el of document.querySelectorAll<HTMLElement>("[data-ratio-of]")) {
          const a = readCssLengthPx(el.dataset.ratioOf!);
          const b = readCssLengthPx(el.dataset.ratioTo!);
          el.textContent = b ? `×${(a / b).toFixed(4)}` : "—";
        }

        const gutter = readCssLengthPx("--site--gutter");
        const margin = readCssLengthPx("--site--margin");

        /* --site--column-count is a calc() over the responsive flags, so
           getPropertyValue would hand back the literal expression. Count the
           grid's resolved tracks instead — that is the real answer anyway. */
        const grid = document.querySelector(".grid_cells_wrap");
        const count = grid
          ? String(getComputedStyle(grid).gridTemplateColumns.split(/\s+/).filter(Boolean).length)
          : "—";

        const specified = getComputedStyle(document.documentElement)
          .getPropertyValue("--max-width--main")
          .trim();
        const unlocked = specified === "100vw" || specified === "100%";
        const lock = readCssLengthPx("--max-width--main");
        const containerWidth = grid ? grid.getBoundingClientRect().width : 0;
        const columnWidth = readCssLengthPx("--site--column-width");

        const metrics: Record<string, string> = {
          count,
          gutter: `${gutter.toFixed(1)}px`,
          margin: `${margin.toFixed(1)}px`,
          ratio: gutter ? (margin / gutter).toFixed(3) : "—",
          lock: unlocked ? "unlocked" : `${(lock / rootPx).toFixed(0)}rem`,
          /* Locked once the container has stopped growing with the viewport. */
          container: `${containerWidth.toFixed(0)}px ${
            !unlocked && containerWidth >= lock - 0.5 ? "· locked" : "· fluid"
          }`,
          proportion: columnWidth ? `${((gutter / columnWidth) * 100).toFixed(1)}%` : "—",
        };

        for (const [key, value] of Object.entries(metrics)) {
          const el = document.querySelector(`[data-metric="${key}"]`);
          if (el) el.textContent = value;
        }
      };

      paintMetrics = paint;

      /* Paint once up front — ResizeObserver's initial delivery waits on a
         rendering frame, which never arrives in a hidden or background tab, so
         relying on it alone can leave the readout blank. Then observe for
         updates: RO catches layout changes that fire no resize event at all
         (zoom, a root font-size change, devtools viewport overrides). */
      paint();
      new ResizeObserver(paint).observe(document.documentElement);
    });

    document.querySelectorAll<HTMLElement>(".grid_lock_wrap").forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = "true";

      const toggle = component.querySelector<HTMLInputElement>("[data-container-lock]");
      const widthInput = component.querySelector<HTMLInputElement>("[data-container-width]");
      const applyButton = component.querySelector<HTMLButtonElement>("[data-container-apply]");
      const resetButton = component.querySelector<HTMLButtonElement>("[data-container-reset]");
      if (!toggle || !widthInput || !applyButton || !resetButton) return;

      const syncUi = (settings: ReturnType<typeof readContainerLockSettings>) => {
        toggle.checked = settings.locked;
        widthInput.value = String(settings.widthRem);
        widthInput.disabled = !settings.locked;
        applyButton.disabled = !settings.locked;
      };

      const commit = (settings: ReturnType<typeof readContainerLockSettings>) => {
        applyContainerLockSettings(settings);
        syncUi(settings);
        void persist(
          { container: settings },
          () => writeContainerLockSettings(settings),
          () => clearContainerLockStorage(),
        );
      };

      const readWidth = () => {
        const parsed = parseFloat(widthInput.value);
        if (!Number.isFinite(parsed) || parsed <= 0) return DEFAULT_CONTAINER_WIDTH_REM;
        return Math.min(200, Math.max(20, parsed));
      };

      syncUi(readContainerLockSettings());

      toggle.addEventListener("change", () => {
        commit({ locked: toggle.checked, widthRem: readWidth() });
      });

      applyButton.addEventListener("click", () => {
        commit({ locked: true, widthRem: readWidth() });
      });

      widthInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          commit({ locked: true, widthRem: readWidth() });
        }
      });

      resetButton.addEventListener("click", () => {
        const settings = { locked: true, widthRem: DEFAULT_CONTAINER_WIDTH_REM };
        applyContainerLockSettings(settings);
        syncUi(settings);
        void persist(
          { container: settings },
          () => {
            clearContainerLockOverride();
            applyContainerLockSettings(settings);
          },
          () => clearContainerLockStorage(),
        );
      });
    });

    document.querySelectorAll<HTMLElement>(".colour_swatches_wrap").forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = "true";

      const inputs = component.querySelectorAll<HTMLInputElement>("[data-swatch]");
      const hexInputs = component.querySelectorAll<HTMLInputElement>("[data-swatch-hex]");
      const resetButton = document.querySelector<HTMLButtonElement>("[data-swatch-reset]");
      const extrasRoot = document.querySelector<HTMLElement>("[data-swatch-extras]");
      const extrasTemplate = document.querySelector<HTMLElement>(
        ".colour_extras_hidden .colour_swatch_wrap.is-extra",
      );
      const addName = document.querySelector<HTMLInputElement>("[data-swatch-add-name]");
      const addPicker = document.querySelector<HTMLInputElement>("[data-swatch-add-picker]");
      const addHex = document.querySelector<HTMLInputElement>("[data-swatch-add-hex]");
      const addButton = document.querySelector<HTMLButtonElement>("[data-swatch-add]");
      const addStatus = document.querySelector<HTMLElement>("[data-swatch-add-status]");
      if (!inputs.length) return;

      const syncUi = (settings: ReturnType<typeof readSwatchSettings>) => {
        for (const input of inputs) {
          const key = input.dataset.swatch as SwatchKey | undefined;
          if (!key || !SWATCH_KEYS.includes(key)) continue;
          input.value = settings[key];
        }
        for (const input of hexInputs) {
          const key = input.dataset.swatchHex as SwatchKey | undefined;
          if (!key || !SWATCH_KEYS.includes(key)) continue;
          input.value = settings[key];
        }
      };

      const readFromInputs = () => {
        const settings = { ...DEFAULT_SWATCHES };
        for (const input of inputs) {
          const key = input.dataset.swatch as SwatchKey | undefined;
          if (!key || !SWATCH_KEYS.includes(key)) continue;
          settings[key] = input.value;
        }
        return settings;
      };

      const persistExtras = (extras: ReturnType<typeof readExtraSwatches>) => {
        applyExtraSwatches(extras);
        void persist(
          { extraSwatches: extras },
          () => writeExtraSwatches(extras),
          () => clearExtraSwatchStorage(),
        );
      };

      const renderExtras = () => {
        if (!extrasRoot || !extrasTemplate) return;
        extrasRoot.replaceChildren();
        for (const swatch of listExtraSwatches()) {
          const node = extrasTemplate.cloneNode(true) as HTMLElement;
          const input = node.querySelector<HTMLInputElement>("[data-extra-swatch]");
          const hexInput = node.querySelector<HTMLInputElement>("[data-extra-swatch-hex]");
          const chip = node.querySelector<HTMLElement>(".colour_swatch.is-extra");
          const caption = node.querySelector<HTMLElement>(".colour_swatch_caption");
          const removeButton = node.querySelector<HTMLButtonElement>("[data-extra-remove]");
          if (!input || !chip || !caption || !removeButton) continue;

          input.value = swatch.hex;
          if (hexInput) hexInput.value = swatch.hex;
          input.dataset.extraSwatch = swatch.slug;
          chip.style.setProperty("background-color", `var(${swatch.token})`);
          caption.textContent = swatch.token;
          removeButton.dataset.extraRemove = swatch.slug;

          const commitExtra = (hex: string) => {
            const colour = normalizeHex(hex, swatch.hex);
            input.value = colour;
            if (hexInput) hexInput.value = colour;
            const extras = readExtraSwatches();
            extras[swatch.slug] = colour;
            writeExtraSwatches(extras);
            persistExtras(extras);
          };

          input.addEventListener("input", () => commitExtra(input.value));
          hexInput?.addEventListener("change", () => commitExtra(hexInput.value));
          hexInput?.addEventListener("keydown", (event) => {
            if (event.key === "Enter") {
              event.preventDefault();
              commitExtra(hexInput.value);
            }
          });

          removeButton.addEventListener("click", () => {
            removeSwatch(swatch.slug);
            persistExtras(readExtraSwatches());
            renderExtras();
          });

          extrasRoot.appendChild(node);
        }
      };

      const commit = (settings: ReturnType<typeof readSwatchSettings>) => {
        applySwatchSettings(settings);
        syncUi(settings);
        void persist(
          { swatches: settings },
          () => writeSwatchSettings(settings),
          () => clearSwatchStorage(),
        );
      };

      const initial = readSwatchSettings();
      applySwatchSettings(initial);
      syncUi(initial);

      const initialExtras = readExtraSwatches();
      applyExtraSwatches(initialExtras);
      renderExtras();

      for (const input of inputs) {
        input.addEventListener("input", () => {
          commit(readFromInputs());
        });
      }

      for (const hexInput of hexInputs) {
        const applyHex = () => {
          const key = hexInput.dataset.swatchHex as SwatchKey | undefined;
          if (!key || !SWATCH_KEYS.includes(key)) return;
          const settings = readFromInputs();
          settings[key] = normalizeHex(hexInput.value, settings[key]);
          commit(settings);
        };
        hexInput.addEventListener("change", applyHex);
        hexInput.addEventListener("keydown", (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            applyHex();
          }
        });
      }

      const syncAddColour = (hex: string) => {
        const colour = normalizeHex(hex, "#e36a5c");
        if (addPicker) addPicker.value = colour;
        if (addHex) addHex.value = colour;
      };

      addPicker?.addEventListener("input", () => syncAddColour(addPicker.value));
      addHex?.addEventListener("change", () => syncAddColour(addHex.value));
      addHex?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          syncAddColour(addHex.value);
        }
      });

      addButton?.addEventListener("click", () => {
        const name = addName?.value ?? "";
        const hex = addHex?.value ?? addPicker?.value ?? "#e36a5c";
        const created = addSwatch(name, hex);
        if (!created) {
          if (addStatus) {
            addStatus.textContent =
              "Use a short name (a-z, 0-9, hyphen) that is not already reserved.";
          }
          return;
        }
        if (addName) addName.value = "";
        if (addStatus) addStatus.textContent = `Added ${created.token}`;
        persistExtras(readExtraSwatches());
        renderExtras();
      });

      resetButton?.addEventListener("click", () => {
        const settings = { ...DEFAULT_SWATCHES };
        applySwatchSettings(settings);
        syncUi(settings);
        void persist(
          { swatches: settings },
          () => {
            clearSwatchOverride();
            applySwatchSettings(settings);
          },
          () => clearSwatchStorage(),
        );
      });
    });

    document.querySelectorAll<HTMLElement>(".type_specimen_wrap").forEach((component) => {
      if (component.dataset.fontScriptInitialized) return;
      component.dataset.fontScriptInitialized = "true";

      const fontSelects = component.querySelectorAll<HTMLSelectElement>("[data-text-style-font]");
      const wrapSelects = component.querySelectorAll<HTMLSelectElement>("[data-text-style-wrap]");
      const transformSelects = component.querySelectorAll<HTMLSelectElement>(
        "[data-text-style-transform]",
      );
      const alignSelects = component.querySelectorAll<HTMLSelectElement>("[data-text-style-align]");
      const weightSelects = component.querySelectorAll<HTMLSelectElement>("[data-text-style-weight]");
      const resetButton = document.querySelector<HTMLButtonElement>("[data-text-style-font-reset]");
      if (!fontSelects.length) return;

      const syncFontUi = (settings: ReturnType<typeof readTextStyleFontSettings>) => {
        for (const select of fontSelects) {
          const key = select.dataset.textStyleFont as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          select.value = settings[key];
        }
      };

      const syncOptionUi = (settings: TextStyleOptions) => {
        for (const select of wrapSelects) {
          const key = select.dataset.textStyleWrap as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          select.value = settings.wrap[key];
        }
        for (const select of transformSelects) {
          const key = select.dataset.textStyleTransform as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          select.value = settings.transform[key];
        }
        for (const select of alignSelects) {
          const key = select.dataset.textStyleAlign as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          select.value = settings.align[key];
        }
        for (const select of weightSelects) {
          const key = select.dataset.textStyleWeight as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          select.value = settings.weight[key];
        }
      };

      const readFonts = () => {
        const settings = { ...DEFAULT_TEXT_STYLE_FONTS };
        for (const select of fontSelects) {
          const key = select.dataset.textStyleFont as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          if (isFontRole(select.value)) settings[key] = select.value;
        }
        return settings;
      };

      const readOptions = (): TextStyleOptions => {
        const settings: TextStyleOptions = {
          wrap: { ...DEFAULT_TEXT_STYLE_OPTIONS.wrap },
          transform: { ...DEFAULT_TEXT_STYLE_OPTIONS.transform },
          align: { ...DEFAULT_TEXT_STYLE_OPTIONS.align },
          weight: { ...DEFAULT_TEXT_STYLE_OPTIONS.weight },
        };
        for (const select of wrapSelects) {
          const key = select.dataset.textStyleWrap as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          if (isTextWrap(select.value)) settings.wrap[key] = select.value;
        }
        for (const select of transformSelects) {
          const key = select.dataset.textStyleTransform as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          if (isTextTransform(select.value)) settings.transform[key] = select.value;
        }
        for (const select of alignSelects) {
          const key = select.dataset.textStyleAlign as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          if (isTextAlign(select.value)) settings.align[key] = select.value;
        }
        for (const select of weightSelects) {
          const key = select.dataset.textStyleWeight as TextStyleKey | undefined;
          if (!key || !TEXT_STYLE_KEYS.includes(key)) continue;
          if (isTextWeight(select.value)) settings.weight[key] = select.value;
        }
        return settings;
      };

      const commitFonts = (settings: ReturnType<typeof readTextStyleFontSettings>) => {
        if (!readTypeStylesEnabled()) return;
        applyTextStyleFontSettings(settings);
        syncFontUi(settings);
        void persist(
          { textStyleFonts: settings },
          () => writeTextStyleFontSettings(settings),
          () => clearTextStyleFontStorage(),
        );
      };

      const commitOptions = (settings: TextStyleOptions) => {
        if (!readTypeStylesEnabled()) return;
        applyTextStyleOptionSettings(settings);
        syncOptionUi(settings);
        void persist(
          { textStyleOptions: settings },
          () => writeTextStyleOptionSettings(settings),
          () => clearTextStyleOptionStorage(),
        );
      };

      const initialFonts = readTextStyleFontSettings();
      const initialOptions = readTextStyleOptionSettings();
      syncFontUi(initialFonts);
      syncOptionUi(initialOptions);
      if (readTypeStylesEnabled()) {
        applyTextStyleFontSettings(initialFonts);
        applyTextStyleOptionSettings(initialOptions);
      }

      for (const select of fontSelects) {
        select.addEventListener("change", () => {
          commitFonts(readFonts());
        });
      }

      for (const select of [
        ...wrapSelects,
        ...transformSelects,
        ...alignSelects,
        ...weightSelects,
      ]) {
        select.addEventListener("change", () => {
          commitOptions(readOptions());
        });
      }

      resetButton?.addEventListener("click", () => {
        if (!readTypeStylesEnabled()) return;
        const fonts = { ...DEFAULT_TEXT_STYLE_FONTS };
        const options: TextStyleOptions = {
          wrap: { ...DEFAULT_TEXT_STYLE_OPTIONS.wrap },
          transform: { ...DEFAULT_TEXT_STYLE_OPTIONS.transform },
          align: { ...DEFAULT_TEXT_STYLE_OPTIONS.align },
          weight: { ...DEFAULT_TEXT_STYLE_OPTIONS.weight },
        };
        applyTextStyleFontSettings(fonts);
        applyTextStyleOptionSettings(options);
        syncFontUi(fonts);
        syncOptionUi(options);
        void persist(
          { textStyleFonts: fonts, textStyleOptions: options },
          () => {
            clearTextStyleFontOverride();
            clearTextStyleOptionOverride();
            applyTextStyleFontSettings(fonts);
            applyTextStyleOptionSettings(options);
          },
          () => {
            clearTextStyleFontStorage();
            clearTextStyleOptionStorage();
          },
        );
      });
    });

    const fillFontSelects = (catalog: FontCatalogEntry[]) => {
      const selects = document.querySelectorAll<HTMLSelectElement>("[data-font-family]");
      for (const select of selects) {
        const current = select.value;
        select.replaceChildren();
        for (const entry of catalog) {
          const option = document.createElement("option");
          option.value = entry.stack;
          option.textContent =
            entry.source === "typekit" ? `${entry.family} (Typekit)` : entry.family;
          select.appendChild(option);
        }
        const match = catalog.find((entry) => entry.stack === current);
        select.value = match ? match.stack : NEXUS_FONT_STACK;
      }
    };

    const syncFamilySamples = (settings: ReturnType<typeof readFontFamilySettings>) => {
      for (const role of FONT_ROLES) {
        const sample = document.querySelector<HTMLElement>(`[data-font-family-sample="${role}"]`);
        if (!sample) continue;
        sample.style.fontFamily = settings[role];
        const label = settings[role].split(",")[0]?.trim() || "Arial";
        sample.textContent = role === "tertiary" ? `${label} 0123456789` : label;
      }
    };

    const setTypeStylesControlsDisabled = (disabled: boolean) => {
      document.querySelectorAll<HTMLSelectElement>(
        "[data-text-style-font], [data-text-style-wrap], [data-text-style-transform], [data-text-style-align], [data-text-style-weight]",
      ).forEach((el) => {
        el.disabled = disabled;
      });
      const reset = document.querySelector<HTMLButtonElement>("[data-text-style-font-reset]");
      if (reset) reset.disabled = disabled;
      document.querySelectorAll<HTMLElement>(".type_specimen_wrap").forEach((wrap) => {
        wrap.classList.toggle("is-disabled", disabled);
      });
    };

    const syncTypeStylesToggle = (enabled: boolean) => {
      const button = document.querySelector<HTMLButtonElement>("[data-type-styles-toggle]");
      if (button) button.textContent = enabled ? "Type styles: on" : "Type styles: off";
      setTypeStylesControlsDisabled(!enabled);
    };

    document.querySelectorAll<HTMLElement>("[data-type-styles-toggle]").forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      if (button.dataset.scriptInitialized) return;
      button.dataset.scriptInitialized = "true";

      const applyEnabled = (enabled: boolean) => {
        applyTypeStylesEnabled(enabled);
        syncTypeStylesToggle(enabled);
        if (enabled) {
          const fonts = readTextStyleFontSettings();
          const options = readTextStyleOptionSettings();
          applyTextStyleFontSettings(fonts);
          applyTextStyleOptionSettings(options);
        }
        void persist(
          { typeStylesEnabled: enabled },
          () => writeTypeStylesEnabled(enabled),
          () => clearTypeStylesEnabledStorage(),
        );
      };

      const initialEnabled = readTypeStylesEnabled();
      applyTypeStylesEnabled(initialEnabled);
      syncTypeStylesToggle(initialEnabled);
      if (initialEnabled) {
        applyTextStyleFontSettings(readTextStyleFontSettings());
        applyTextStyleOptionSettings(readTextStyleOptionSettings());
      }

      button.addEventListener("click", () => {
        applyEnabled(!readTypeStylesEnabled());
      });
    });

    document.querySelectorAll<HTMLElement>(".type_typekit_wrap").forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = "true";

      const input = component.querySelector<HTMLInputElement>("[data-typekit-kit-id]");
      const addButton = component.querySelector<HTMLButtonElement>("[data-typekit-add]");
      const clearButton = component.querySelector<HTMLButtonElement>("[data-typekit-clear]");
      const status = component.querySelector<HTMLElement>("[data-typekit-status]");
      if (!input) return;

      const setStatus = (message: string) => {
        if (status) status.textContent = message;
      };

      const initialKit = readTypekitKitId();
      if (initialKit) {
        input.value = initialKit;
        ensureTypekitLink(initialKit);
      }
      fillFontSelects(readFontCatalog());

      addButton?.addEventListener("click", async () => {
        const kitId = input.value.trim();
        setStatus("Loading kit…");
        try {
          const families = await fetchTypekitFamilies(kitId);
          if (!families.length) {
            setStatus("Kit loaded but no @font-face families were found.");
            return;
          }
          ensureTypekitLink(kitId);
          writeTypekitKitId(kitId);
          const catalog = mergeFontCatalog(DEFAULT_FONT_CATALOG, families);
          writeFontCatalog(catalog);
          fillFontSelects(catalog);
          setStatus(`Added ${families.length} face(s): ${families.join(", ")}`);
          void persist(
            { typekitKitId: kitId },
            () => writeTypekitKitId(kitId),
            () => {},
          );
        } catch (error) {
          setStatus(error instanceof Error ? error.message : String(error));
        }
      });

      clearButton?.addEventListener("click", () => {
        input.value = "";
        ensureTypekitLink("");
        clearTypekitKitId();
        clearFontCatalogStorage();
        fillFontSelects(DEFAULT_FONT_CATALOG);
        setStatus("Typekit cleared — catalog reset to Arial.");
        void persist(
          { typekitKitId: "" },
          () => clearTypekitKitId(),
          () => {},
        );
      });
    });

    document.querySelectorAll<HTMLElement>(".type_families_wrap").forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = "true";

      const selects = component.querySelectorAll<HTMLSelectElement>("[data-font-family]");
      const applyButton = document.querySelector<HTMLButtonElement>("[data-font-family-apply]");
      const resetButton = document.querySelector<HTMLButtonElement>("[data-font-family-reset]");
      if (!selects.length) return;

      fillFontSelects(readFontCatalog());

      const syncUi = (settings: ReturnType<typeof readFontFamilySettings>) => {
        for (const select of selects) {
          const role = select.dataset.fontFamily as FontRole | undefined;
          if (!role || !FONT_ROLES.includes(role)) continue;
          const stack = settings[role];
          if (![...select.options].some((opt) => opt.value === stack)) {
            const option = document.createElement("option");
            option.value = stack;
            option.textContent = stack.split(",")[0]?.trim() || stack;
            select.appendChild(option);
          }
          select.value = stack;
        }
        syncFamilySamples(settings);
      };

      const readFromSelects = () => {
        const settings = { ...DEFAULT_FONT_FAMILIES };
        for (const select of selects) {
          const role = select.dataset.fontFamily as FontRole | undefined;
          if (!role || !FONT_ROLES.includes(role)) continue;
          settings[role] = select.value.trim() || NEXUS_FONT_STACK;
        }
        return settings;
      };

      const commit = (settings: ReturnType<typeof readFontFamilySettings>) => {
        applyFontFamilySettings(settings);
        syncUi(settings);
        void persist(
          { fontFamilies: settings },
          () => writeFontFamilySettings(settings),
          () => clearFontFamilyStorage(),
        );
      };

      const initial = readFontFamilySettings();
      applyFontFamilySettings(initial);
      syncUi(initial);

      applyButton?.addEventListener("click", () => {
        commit(readFromSelects());
      });

      for (const select of selects) {
        select.addEventListener("change", () => {
          const settings = readFromSelects();
          applyFontFamilySettings(settings);
          syncFamilySamples(settings);
          void persist(
            { fontFamilies: settings },
            () => writeFontFamilySettings(settings),
            () => clearFontFamilyStorage(),
          );
        });
      }

      resetButton?.addEventListener("click", () => {
        const settings = { ...DEFAULT_FONT_FAMILIES };
        applyFontFamilySettings(settings);
        syncUi(settings);
        void persist(
          { fontFamilies: settings },
          () => {
            clearFontFamilyOverride();
            applyFontFamilySettings(settings);
          },
          () => clearFontFamilyStorage(),
        );
      });
    });

    document.querySelectorAll<HTMLElement>(".button_controls_wrap").forEach((component) => {
      if (component.dataset.scriptInitialized) return;
      component.dataset.scriptInitialized = "true";

      const selects = component.querySelectorAll<HTMLSelectElement>("[data-button-style]");
      const radiusSlider = component.querySelector<HTMLInputElement>("[data-button-radius-slider]");
      const radiusPill = component.querySelector<HTMLInputElement>("[data-button-radius-pill]");
      const radiusValue = component.querySelector<HTMLElement>("[data-button-radius-value]");
      const resetButton = document.querySelector<HTMLButtonElement>("[data-button-style-reset]");
      if (!selects.length) return;

      const syncRadiusUi = (radius: string) => {
        const pill = isPillRadius(radius);
        if (radiusPill) radiusPill.checked = pill;
        if (radiusSlider) {
          radiusSlider.disabled = pill;
          const rem = radiusToRem(radius);
          radiusSlider.value = String(rem ?? 1);
        }
        if (radiusValue) radiusValue.textContent = pill ? "Pill" : radius;
      };

      const syncUi = (settings: ReturnType<typeof readButtonStyleSettings>) => {
        for (const select of selects) {
          const key = select.dataset.buttonStyle as ButtonStyleKey | undefined;
          if (!key || !BUTTON_STYLE_KEYS.includes(key)) continue;
          select.value = settings[key];
        }
        syncRadiusUi(settings.radius);
      };

      const readFromControls = () => {
        const settings = { ...DEFAULT_BUTTON_STYLES };
        for (const select of selects) {
          const key = select.dataset.buttonStyle as ButtonStyleKey | undefined;
          if (!key || !BUTTON_STYLE_KEYS.includes(key)) continue;
          settings[key] = select.value;
        }
        if (radiusPill?.checked) {
          settings.radius = "100vw";
        } else if (radiusSlider) {
          settings.radius = remToRadius(Number(radiusSlider.value));
        }
        return settings;
      };

      const commit = (settings: ReturnType<typeof readButtonStyleSettings>) => {
        applyButtonStyleSettings(settings);
        syncUi(settings);
        void persist(
          { buttonStyles: settings },
          () => writeButtonStyleSettings(settings),
          () => clearButtonStyleStorage(),
        );
      };

      const initial = readButtonStyleSettings();
      applyButtonStyleSettings(initial);
      syncUi(initial);

      for (const select of selects) {
        select.addEventListener("change", () => {
          commit(readFromControls());
        });
      }

      radiusSlider?.addEventListener("input", () => {
        if (radiusPill) radiusPill.checked = false;
        commit(readFromControls());
      });

      radiusPill?.addEventListener("change", () => {
        commit(readFromControls());
      });

      resetButton?.addEventListener("click", () => {
        const settings = { ...DEFAULT_BUTTON_STYLES };
        applyButtonStyleSettings(settings);
        syncUi(settings);
        void persist(
          { buttonStyles: settings },
          () => {
            clearButtonStyleOverride();
            applyButtonStyleSettings(settings);
          },
          () => clearButtonStyleStorage(),
        );
      });
    });

    const wireRungSelect = (
      select: HTMLSelectElement | null,
      resetButton: HTMLButtonElement | null,
      key: "gutter" | "padding",
    ) => {
      if (!select) return;

      const readCurrent = () => readSpacingRungSettings();

      const syncUi = (settings: ReturnType<typeof readSpacingRungSettings>) => {
        select.value = String(settings[key]);
      };

      const commit = (settings: ReturnType<typeof readSpacingRungSettings>) => {
        applySpacingRungSettings(settings);
        syncUi(settings);
        void persist(
          { spacingRungs: settings },
          () => writeSpacingRungSettings(settings),
          () => clearSpacingRungStorage(),
        );
      };

      const initial = readCurrent();
      applySpacingRungSettings(initial);
      syncUi(initial);

      select.addEventListener("change", () => {
        const next = { ...readCurrent(), [key]: Number(select.value) };
        commit(next);
      });

      resetButton?.addEventListener("click", () => {
        const settings = {
          ...readCurrent(),
          [key]: DEFAULT_SPACING_RUNGS[key],
        };
        applySpacingRungSettings(settings);
        syncUi(settings);
        void persist(
          { spacingRungs: settings },
          () => writeSpacingRungSettings(settings),
          () => clearSpacingRungStorage(),
        );
      });
    };

    wireRungSelect(
      document.querySelector<HTMLSelectElement>("[data-gutter-rung]"),
      document.querySelector<HTMLButtonElement>("[data-gutter-rung-reset]"),
      "gutter",
    );
    wireRungSelect(
      document.querySelector<HTMLSelectElement>("[data-padding-rung]"),
      document.querySelector<HTMLButtonElement>("[data-padding-rung-reset]"),
      "padding",
    );

    /* Bundle flags. Unlike every other control on this page these have no
       runtime effect to apply — they decide what the *next build* contains, so
       there is no localStorage fallback worth offering: without the dev server
       there is nothing a browser can do about the bundle. Say so instead. */
    const featureStatus = document.querySelector<HTMLElement>("[data-feature-status]");

    for (const key of FEATURE_KEYS) {
      const toggle = document.querySelector<HTMLInputElement>(`[data-feature="${key}"]`);
      if (!toggle) continue;

      toggle.addEventListener("change", () => {
        const enabled = toggle.checked;
        const label = FEATURE_META[key].label;
        toggle.disabled = true;

        void saveTokensToCss({ features: { [key]: enabled } }).then((saved) => {
          toggle.disabled = false;
          if (saved) {
            if (featureStatus) {
              featureStatus.textContent =
                `${label} ${enabled ? "on" : "off"} — features.json updated, reloading…`;
            }
            /* features.json is a build input, so the page has to come back from
               the server to reflect it. */
            window.location.reload();
            return;
          }
          toggle.checked = !enabled;
          if (featureStatus) {
            featureStatus.textContent =
              "Dev server unavailable — bundle flags can only change during astro dev";
          }
        });
      });
    }
  });
</script>
