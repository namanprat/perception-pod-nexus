---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import GridLines from '../../components/GridLines.astro';

import rawFeatures from "../../features.json";
import { FEATURE_KEYS, FEATURE_META, normaliseFeatures } from "../../lib/features";
import { RUNG_OPTIONS } from "../../lib/spacing-rungs";
import {
  TEXT_ALIGN_OPTIONS,
  TEXT_TRANSFORM_OPTIONS,
  TEXT_WEIGHT_OPTIONS,
  TEXT_WRAP_OPTIONS,
} from "../../lib/text-style-options";
import { TEXT_STYLE_KEYS } from "../../lib/text-style-fonts";
import { BUTTON_PADDING_PRESET_OPTIONS } from "../../lib/button-styles";

const features = normaliseFeatures(rawFeatures);

const ladder = [
  { i: 0, value: "0.786", note: "phi^-0.5" },
  { i: 1, value: "1", note: "base" },
  { i: 2, value: "1.272", note: "sqrt-phi" },
  { i: 3, value: "1.618", note: "phi" },
  { i: 4, value: "2.058", note: "" },
  { i: 5, value: "2.618", note: "phi^2" },
  { i: 6, value: "3.33", note: "" },
  { i: 7, value: "4.236", note: "phi^3" },
  { i: 8, value: "5.388", note: "" },
  { i: 9, value: "6.854", note: "phi^4" },
  { i: 10, value: "8.72", note: "" },
  { i: 11, value: "11.09", note: "phi^5" },
];

const typeScale = [
  { key: "display", token: "--_typography---size--display", label: "Display", style: "u-text-style-display", rung: "phi-8 → phi-10", tag: "h1", font: "primary" },
  { key: "h1", token: "--_typography---size--h1", label: "Heading 1", style: "u-text-style-h1", rung: "phi-6 → phi-8", tag: "h1", font: "primary" },
  { key: "h2", token: "--_typography---size--h2", label: "Heading 2", style: "u-text-style-h2", rung: "phi-5 → phi-7", tag: "h2", font: "primary" },
  { key: "h3", token: "--_typography---size--h3", label: "Heading 3", style: "u-text-style-h3", rung: "phi-3 → phi-5", tag: "h3", font: "primary" },
  { key: "h4", token: "--_typography---size--h4", label: "Heading 4", style: "u-text-style-h4", rung: "phi-2 → phi-4", tag: "h4", font: "primary" },
  { key: "h5", token: "--_typography---size--h5", label: "Heading 5", style: "u-text-style-h5", rung: "phi-1 → phi-3", tag: "h5", font: "primary" },
  { key: "h6", token: "--_typography---size--h6", label: "Heading 6", style: "u-text-style-h6", rung: "phi-1 (= main)", tag: "h6", font: "tertiary" },
  { key: "large", token: "--_typography---size--large", label: "Large", style: "u-text-style-large", rung: "phi-2", tag: "p", font: "secondary" },
  { key: "main", token: "--_typography---size--main", label: "Main", style: "u-text-style-main", rung: "phi-1", tag: "p", font: "secondary" },
  { key: "small", token: "--_typography---size--small", label: "Small", style: "u-text-style-small", rung: "phi-0", tag: "p", font: "secondary" },
];

const fontRoles = [
  { value: "primary", label: "Primary" },
  { value: "secondary", label: "Secondary" },
  { value: "tertiary", label: "Tertiary" },
] as const;

const textStyleFontLabels: Record<(typeof TEXT_STYLE_KEYS)[number], string> = {
  display: "Display",
  h1: "Heading 1",
  h2: "Heading 2",
  h3: "Heading 3",
  h4: "Heading 4",
  h5: "Heading 5",
  h6: "Heading 6",
  large: "Large",
  main: "Main",
  small: "Small",
  mono: "Mono",
  eyebrow: "Eyebrow",
};

const fontFamilies = [
  { role: "primary", token: "--_typography---font--primary", sample: "New Spirit", value: '"new-spirit-condensed", Georgia, serif' },
  { role: "secondary", token: "--_typography---font--secondary", sample: "Arial", value: "Arial, sans-serif" },
  { role: "tertiary", token: "--_typography---font--tertiary", sample: "Arial 0123456789", value: "Arial, sans-serif" },
] as const;

const buttonColourOptions = [
  { label: "Light", token: "--swatch--light-100" },
  { label: "Dark", token: "--swatch--dark-900" },
  { label: "Brand", token: "--swatch--brand-500" },
  { label: "Accent", token: "--swatch--accent" },
  { label: "Overscroll", token: "--swatch--overscroll" },
] as const;

const buttonStyleControls = [
  { key: "primaryBackground", label: "Primary fill" },
  { key: "primaryBackgroundHover", label: "Primary fill hover" },
  { key: "primaryText", label: "Primary text" },
  { key: "primaryTextHover", label: "Primary text hover" },
  { key: "secondaryText", label: "Secondary text" },
  { key: "secondaryTextHover", label: "Secondary text hover" },
  { key: "tertiaryText", label: "Tertiary text" },
  { key: "tertiaryTextHover", label: "Tertiary text hover" },
] as const;

const spacing = [1, 2, 3, 4, 5, 6, 7, 8];
const ramp = [100, 200, 300, 400, 500, 600, 700, 800, 900];
const spans = [2, 3, 4, 6, 8];
const cells = Array.from({ length: 12 }, (_, i) => i + 1);

const sectionSpace = [
  { token: "--_spacing---section-space--small", label: "small" },
  { token: "--_spacing---section-space--main", label: "main" },
  { token: "--_spacing---section-space--large", label: "large" },
  { token: "--_spacing---section-space--page-top", label: "page-top" },
];
---
<BaseLayout title="Nexus — design system" description="φ-based grid, type and colour tokens for Astro.">
  <!-- ─── Masthead ──────────────────────────────────────────────────── -->
  <Section name="masthead" space="large" pageTop>
    <div class="masthead_content u-margin-trim">
      <p class="masthead_eyebrow u-text-style-eyebrow u-margin-bottom">φ = 1.618033988749895</p>
      <div class="masthead_title u-heading u-text-style-display">
        <h1>Nexus Framework</h1>
      </div>
      <div class="masthead_text u-text u-text-style-large">
        <p>One ladder drives everything. Each rung is the previous rung ×&nbsp;√φ (1.272), so every second rung is exactly φ. Type sizes, column counts, gutters and spacing all read off it — expressed as Nexus variables and utilities.</p>
      </div>
      <p class="masthead_hint u-text-style-mono">Shift&nbsp;+&nbsp;G toggles the grid overlay · resize to watch the columns step 12&nbsp;→&nbsp;8&nbsp;→&nbsp;4</p>
    </div>
  </Section>
  <!-- ─── The ladder ────────────────────────────────────────────────── -->
  <Section name="ladder">
    <h2 class="ladder_title u-text-style-h6">01 — The ladder</h2>
    <ul class="ladder_list_wrap">
      {
        ladder.map(({ i, value, note }) => (
          <li class="ladder_row_wrap">
            <code class="ladder_token u-text-style-mono">--phi-{i}</code>
            <div class="ladder_value u-text-style-mono">{value}</div>
            <div class={`ladder_bar is-${i}`} />
            <div class="ladder_note u-text-style-mono u-text-faded">{note}</div>
          </li>
        ))
      }
    </ul>
  </Section>
  <!-- ─── Grid ──────────────────────────────────────────────────────── -->
  <Section name="grid">
    <h2 class="grid_title u-text-style-h6">02 — Grid</h2>
    <div class="grid_intro u-margin-trim">
      <div class="grid_text u-text u-text-style-main u-text-faded">
        <p>Twelve-column grid — 12 / 8 / 4. Halves, thirds and quarters land on whole columns. Margin is exactly φ × the gutter at every viewport, floor included. The count is assembled from the Nexus responsive flags (wide ≥120em · xlarge · large · medium · small · xsmall). Prefer flags / keyword vars; use @container for one-offs — live length readouts use probe measurement because custom props return specified values.</p>
      </div>
    </div>
    <p class="grid_band_smoke u-text-style-small u-text-faded">Band smoke: stacks below medium; row from large; wide keyword available via --flex-wide.</p>
    <div class="grid_demo_wrap">
      <GridLines inset />
      <div class="grid_cells_wrap u-grid-main">
        {
          cells.map((n) => (
            <div class={`grid_cell_wrap ${n >= 9 ? "is-9" : n >= 5 ? "is-5" : ""}`.trim()}>
              <div class="grid_cell_label u-text-style-mono">{String(n).padStart(2, "0")}</div>
            </div>
          ))
        }
      </div>
    </div>
    <dl class="grid_metrics_wrap">
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">columns</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="count">—</dd>
      </div>
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">gutter</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="gutter">—</dd>
      </div>
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">margin</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="margin">—</dd>
      </div>
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">margin ÷ gutter</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="ratio">—</dd>
      </div>
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">--max-width--main</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="lock">—</dd>
      </div>
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">container</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="container">—</dd>
      </div>
      <div class="grid_metric_wrap">
        <dt class="grid_metric_label u-text-style-mono u-text-faded">gutter ÷ column</dt>
        <dd class="grid_metric_value u-text-style-h4" data-metric="proportion">—</dd>
      </div>
    </dl>
    <h3 class="grid_subtitle u-text-style-mono u-text-faded">Container lock</h3>
    <div class="grid_lock_wrap">
      <p class="grid_lock_text u-text-style-small u-text-faded">Sets <code class="grid_lock_code u-text-style-mono">--max-width--main</code> in <code class="grid_lock_code u-text-style-mono">variables.css</code> during <code class="grid_lock_code u-text-style-mono">astro dev</code>.</p>
      <div class="grid_lock_controls_wrap">
        <label class="grid_lock_toggle_wrap">
          <input class="grid_lock_toggle" type="checkbox" data-container-lock checked />
          <div class="grid_lock_toggle_label u-text-style-mono">Lock container</div>
        </label>
        <label class="grid_lock_width_wrap">
          <div class="grid_lock_width_label u-text-style-mono u-text-faded">Width</div>
          <div class="grid_lock_width_field_wrap">
            <input class="grid_lock_width" type="number" inputmode="decimal" min="20" max="200" step="1" value="90" data-container-width />
            <div class="grid_lock_width_unit u-text-style-mono u-text-faded">rem</div>
          </div>
        </label>
        <div class="grid_lock_actions u-button-wrapper">
          <button class="grid_lock_button" type="button" data-container-apply data-trigger="hover focus">Apply width</button>
          <button class="grid_lock_button_secondary" type="button" data-container-reset data-trigger="hover focus">Reset</button>
        </div>
      </div>
    </div>
    <h3 class="grid_subtitle u-text-style-mono u-text-faded">Gutter rung</h3>
    <div class="grid_rung_wrap">
      <p class="grid_lock_text u-text-style-small u-text-faded">Shifts the gutter floor, fluid band and lock cap together by √φ per step. Floor base is <code class="grid_lock_code u-text-style-mono">--_spacing---space--4</code>; −1 is one rung down (≈ space--3). Margin stays φ × gutter.</p>
      <div class="grid_rung_controls_wrap">
        <label class="grid_rung_field_wrap">
          <div class="grid_lock_width_label u-text-style-mono u-text-faded">Rung</div>
          <select class="grid_rung_select" data-gutter-rung>
            {
              RUNG_OPTIONS.map(({ value, label }) => (
                <option value={value} selected={value === 0}>{label}</option>
              ))
            }
          </select>
        </label>
        <button class="grid_lock_button_secondary" type="button" data-gutter-rung-reset data-trigger="hover focus">Reset</button>
      </div>
    </div>
    <h3 class="grid_subtitle u-text-style-mono u-text-faded">Column spans</h3>
    <div class="grid_spans_wrap u-grid-main">
      {
        spans.map((n) => (
          <div class={`grid_span_wrap u-column-span-${n}`}>
            <div class="grid_span_label u-text-style-mono">u-column-span-{n}</div>
          </div>
        ))
      }
    </div>
  </Section>
  <!-- ─── Type ──────────────────────────────────────────────────────── -->
  <Section name="type">
    <h2 class="type_title u-text-style-h6">03 — Type</h2>
    <div class="type_intro u-margin-trim">
      <div class="type_text u-text u-text-style-main u-text-faded">
        <p>Four static UI sizes, six fluid display sizes. Nexus chrome stays on Arial; type styles and the site use the families you pick. Disable type styles to force Arial everywhere and ignore the per-style controls.</p>
      </div>
    </div>
    <div class="type_master_wrap u-font-nexus">
      <button class="type_font_button" type="button" data-type-styles-toggle data-trigger="hover focus">Type styles: on</button>
      <p class="type_master_hint u-text-style-small u-text-faded">When off, <code class="type_code u-text-style-mono">u-text-style-*</code> and site body/headings use Nexus Arial only.</p>
    </div>
    <p class="type_save_status u-text-style-mono u-text-faded" data-save-status>
    </p>
    <div class="type_specimen_wrap">
      {
        typeScale.map(({ key, token, label, style, rung, tag, font }, i) => {
          const Tag = tag;
          return (
            <div class="type_row_wrap">
              <div class="type_meta_wrap">
                <code class="type_token u-text-style-mono">{token}</code>
                <div class="type_rung u-text-style-mono u-text-faded">{rung}</div>
                <div class="type_computed u-text-style-mono" data-computed={token}>
                  —
                </div>
                {typeScale[i + 1] && (
                  <div
                    class="type_ratio u-text-style-mono"
                    data-ratio-of={token}
                    data-ratio-to={typeScale[i + 1].token}
                  >
                    —
                  </div>
                )}
                <div class="type_option_controls_wrap u-font-nexus">
                  <label class="type_font_wrap">
                    <div class="type_font_label u-text-style-mono u-text-faded">Font</div>
                    <select class="type_font_select" data-text-style-font={key}>
                      {fontRoles.map((role) => (
                        <option value={role.value} selected={role.value === font}>
                          {role.label}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="type_font_wrap">
                    <div class="type_font_label u-text-style-mono u-text-faded">Wrap</div>
                    <select class="type_font_select" data-text-style-wrap={key}>
                      {TEXT_WRAP_OPTIONS.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))}
                    </select>
                  </label>
                  <label class="type_font_wrap">
                    <div class="type_font_label u-text-style-mono u-text-faded">Transform</div>
                    <select class="type_font_select" data-text-style-transform={key}>
                      {TEXT_TRANSFORM_OPTIONS.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))}
                    </select>
                  </label>
                  <label class="type_font_wrap">
                    <div class="type_font_label u-text-style-mono u-text-faded">Align</div>
                    <select class="type_font_select" data-text-style-align={key}>
                      {TEXT_ALIGN_OPTIONS.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))}
                    </select>
                  </label>
                  <label class="type_font_wrap">
                    <div class="type_font_label u-text-style-mono u-text-faded">Weight</div>
                    <select class="type_font_select" data-text-style-weight={key}>
                      {TEXT_WEIGHT_OPTIONS.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))}
                    </select>
                  </label>
                </div>
              </div>
              <Tag class={`type_sample ${style}`}>{label} — Revealed, not manufactured</Tag>
            </div>
          );
        })
      }
    </div>
    <div class="type_font_actions u-button-wrapper">
      <button class="type_font_button_secondary" type="button" data-text-style-font-reset data-trigger="hover focus">Reset text styles to CSS defaults</button>
    </div>
    <h3 class="type_subtitle u-text-style-mono u-text-faded u-font-nexus">Adobe Fonts (Typekit)</h3>
    <div class="type_typekit_wrap u-font-nexus">
      <label class="type_typekit_field_wrap">
        <div class="type_family_field_label u-text-style-mono u-text-faded">Kit id</div>
        <input class="type_typekit_input" type="text" spellcheck="false" placeholder="e.g. nci7cab" data-typekit-kit-id />
      </label>
      <div class="type_font_actions u-button-wrapper">
        <button class="type_font_button" type="button" data-typekit-add data-trigger="hover focus">Add kit fonts</button>
        <button class="type_font_button_secondary" type="button" data-typekit-clear data-trigger="hover focus">Clear kit</button>
      </div>
      <p class="type_typekit_status u-text-style-small u-text-faded" data-typekit-status></p>
    </div>
    <h3 class="type_subtitle u-text-style-mono u-text-faded u-font-nexus">Families</h3>
    <div class="type_families_wrap">
      {
        fontFamilies.map(({ role, token, sample, value }) => (
          <div class="type_family_wrap">
            <code class="type_family_token u-text-style-mono u-text-faded u-font-nexus">{token}</code>
            <label class="type_family_field_wrap u-font-nexus">
              <div class="type_family_field_label u-text-style-mono u-text-faded">Font for {role}</div>
              <select class="type_family_select" data-font-family={role} data-default-stack={value}>
                <option value={value} selected>{sample}</option>
              </select>
            </label>
            <p class={`type_family_sample ${role === "tertiary" ? "is-mono" : ""} u-text-style-h4`} data-font-family-sample={role}>{sample}</p>
          </div>
        ))
      }
    </div>
    <div class="type_font_actions u-button-wrapper u-font-nexus">
      <button class="type_font_button" type="button" data-font-family-apply data-trigger="hover focus">Save families to CSS</button>
      <button class="type_font_button_secondary" type="button" data-font-family-reset data-trigger="hover focus">Reset families to Arial</button>
    </div>
  </Section>
  <!-- ─── Colour ────────────────────────────────────────────────────── -->
  <Section name="colour">
    <h2 class="colour_title u-text-style-h6">04 — Colour</h2>
    <div class="colour_intro u-margin-trim">
      <div class="colour_text u-text u-text-style-main u-text-faded">
        <p>Light, dark, brand and accent are the editable bases (with brand and accent ramps). Add more named swatches below — during <code class="colour_code u-text-style-mono">astro dev</code> they write into <code class="colour_code u-text-style-mono">variables.css</code>. Brand theme uses accent for primary actions and headings.</p>
      </div>
    </div>
    <div class="colour_swatches_wrap">
      <figure class="colour_swatch_wrap">
        <label class="colour_swatch_control_wrap">
          <input class="colour_swatch_input" type="color" value="#ffffeb" data-swatch="light" aria-label="Edit light swatch" />
          <div class="colour_swatch is-light">
          </div>
        </label>
        <figcaption class="colour_swatch_caption u-text-style-mono">--swatch--light-100</figcaption>
        <input class="colour_swatch_hex u-text-style-mono" type="text" value="#ffffeb" spellcheck="false" maxlength="7" data-swatch-hex="light" aria-label="Light hex" />
      </figure>
      <figure class="colour_swatch_wrap">
        <label class="colour_swatch_control_wrap">
          <input class="colour_swatch_input" type="color" value="#000000" data-swatch="dark" aria-label="Edit dark swatch" />
          <div class="colour_swatch is-dark">
          </div>
        </label>
        <figcaption class="colour_swatch_caption u-text-style-mono">--swatch--dark-900</figcaption>
        <input class="colour_swatch_hex u-text-style-mono" type="text" value="#000000" spellcheck="false" maxlength="7" data-swatch-hex="dark" aria-label="Dark hex" />
      </figure>
      <figure class="colour_swatch_wrap">
        <label class="colour_swatch_control_wrap">
          <input class="colour_swatch_input" type="color" value="#eae9e4" data-swatch="brand" aria-label="Edit brand swatch" />
          <div class="colour_swatch is-brand">
          </div>
        </label>
        <figcaption class="colour_swatch_caption u-text-style-mono">--swatch--brand-500</figcaption>
        <input class="colour_swatch_hex u-text-style-mono" type="text" value="#eae9e4" spellcheck="false" maxlength="7" data-swatch-hex="brand" aria-label="Brand hex" />
      </figure>
      <figure class="colour_swatch_wrap">
        <label class="colour_swatch_control_wrap">
          <input class="colour_swatch_input" type="color" value="#c17f59" data-swatch="accent" aria-label="Edit accent swatch" />
          <div class="colour_swatch is-accent">
          </div>
        </label>
        <figcaption class="colour_swatch_caption u-text-style-mono">--swatch--accent</figcaption>
        <input class="colour_swatch_hex u-text-style-mono" type="text" value="#c17f59" spellcheck="false" maxlength="7" data-swatch-hex="accent" aria-label="Accent hex" />
      </figure>
      <figure class="colour_swatch_wrap">
        <label class="colour_swatch_control_wrap">
          <input class="colour_swatch_input" type="color" value="#c3c3c3" data-swatch="overscroll" aria-label="Edit overscroll swatch" />
          <div class="colour_swatch is-overscroll">
          </div>
        </label>
        <figcaption class="colour_swatch_caption u-text-style-mono">--swatch--overscroll</figcaption>
        <input class="colour_swatch_hex u-text-style-mono" type="text" value="#c3c3c3" spellcheck="false" maxlength="7" data-swatch-hex="overscroll" aria-label="Overscroll hex" />
      </figure>
    </div>
    <div class="colour_edit_actions u-button-wrapper">
      <button class="colour_edit_button_secondary" type="button" data-swatch-reset data-trigger="hover focus">Reset colours</button>
    </div>
    <h3 class="colour_subtitle u-text-style-mono u-text-faded">Add colour</h3>
    <div class="colour_add_wrap">
      <label class="colour_add_name_wrap">
        <div class="colour_add_label u-text-style-mono u-text-faded">Name</div>
        <input class="colour_add_name" type="text" placeholder="coral" spellcheck="false" data-swatch-add-name />
      </label>
      <label class="colour_add_colour_wrap">
        <div class="colour_add_label u-text-style-mono u-text-faded">Colour</div>
        <div class="colour_add_colour_row">
          <input class="colour_add_colour" type="color" value="#e36a5c" data-swatch-add-picker aria-label="Pick colour" />
