  .ladder_bar.is-3 { width: calc(var(--phi-3) * 1rem); }
  .ladder_bar.is-4 { width: calc(var(--phi-4) * 1rem); }
  .ladder_bar.is-5 { width: calc(var(--phi-5) * 1rem); }
  .ladder_bar.is-6 { width: calc(var(--phi-6) * 1rem); }
  .ladder_bar.is-7 { width: calc(var(--phi-7) * 1rem); }
  .ladder_bar.is-8 { width: calc(var(--phi-8) * 1rem); }
  .ladder_bar.is-9 { width: calc(var(--phi-9) * 1rem); }
  .ladder_bar.is-10 { width: calc(var(--phi-10) * 1rem); }
  .ladder_bar.is-11 { width: calc(var(--phi-11) * 1rem); }

  /* Grid */
  .grid_band_smoke {
    display: var(--flex-medium, flex);
    flex-direction: var(--column-wide, row);
    gap: var(--_spacing---space--3);
    margin-bottom: var(--_spacing---space--4);
  }

  .grid_demo_wrap {
    position: relative;
    width: 100%;
