{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    // For the one React island (src/components/features/Scene.tsx). Astro
    // compiles .astro files itself and ignores these.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
